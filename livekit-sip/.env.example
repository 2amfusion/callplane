# Example for local docker compose or Railway Variables reference.
# On Railway, prefer one multiline SIP_CONFIG_BODY (see config/railway-sip.yaml).

# Railway: set 8080 — entrypoint maps health_port to this value for livekit/sip.
PORT=8080

# Alternative to embedding api_key/api_secret/ws_url in YAML:
LIVEKIT_API_KEY=YOUR_KEY_ID
LIVEKIT_API_SECRET=YOUR_KEY_SECRET
LIVEKIT_WS_URL=wss://callplane-production.up.railway.app

# Full config (Railway recommended):
# SIP_CONFIG_BODY=<paste contents of config/railway-sip.yaml>
#
# First deploy / health debugging — use config/railway-sip-minimal.yaml (use_external_ip: false)
